<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<AnchorPane stylesheets="@../css/main.css" xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1" fx:controller="tangent.gui.MainWindow">
    <children>
        <VBox spacing="2" styleClass="header" AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="0.0" AnchorPane.topAnchor="0.0">
            <children>
                <HBox alignment="CENTER_LEFT" spacing="10">
                    <children>
                        <Label styleClass="header-title" text="TANGENT">
                     <font>
                        <Font name="Google Sans SemiBold" size="19.0" />
                     </font></Label>
                        <Region HBox.hgrow="ALWAYS" />
                      <Label styleClass="header-subtitle" text="your friendly chatbot">
                     <font>
                        <Font name="Comic Sans MS" size="12.0" />
                     </font>
                  </Label>
                    </children>
                </HBox>
            </children>
        </VBox>
        <ScrollPane fx:id="scrollPane" fitToWidth="true" hbarPolicy="NEVER" layoutY="53.333333333333336" prefHeight="121.0" prefWidth="315.0" vbarPolicy="AS_NEEDED" AnchorPane.bottomAnchor="72.0" AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="0.0" AnchorPane.topAnchor="53.0">
            <content>
                <VBox fx:id="dialogContainer" fillWidth="true" styleClass="transcript" />
            </content>
        </ScrollPane>
        <HBox minHeight="72.0" prefHeight="72.0" prefWidth="315.0" spacing="10" styleClass="input-bar" AnchorPane.bottomAnchor="0.0" AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="0.0">
            <children>
                <TextField fx:id="userInput" onAction="#handleUserInput" prefHeight="40.0" promptText="Type a command..." HBox.hgrow="ALWAYS">
               <font>
                  <Font name="Google Sans 17pt Regular" size="12.0" />
               </font></TextField>
                <Button fx:id="sendButton" mnemonicParsing="false" onAction="#handleUserInput" prefHeight="40.0" text="Send  →">
               <font>
                  <Font name="Google Sans Medium" size="12.0" />
               </font></Button>
            </children>
            <padding>
                <Insets bottom="14.0" left="16.0" right="16.0" top="14.0" />
            </padding>
        </HBox>
    </children>
</AnchorPane>
